# Real-model mode. auto uses an explicitly configured OpenAI model, or DeepSeek.
# Fixed replies are only enabled with --demo or SEREIN_PROVIDER=demo.
SEREIN_PROVIDER=auto
SEREIN_CLOUD_ACKNOWLEDGED=true
# DeepSeek: uses DEEPSEEK_API_KEY already present in your environment, if any.
# DEEPSEEK_API_KEY=
# SEREIN_MODEL=deepseek-flash
# Optional: persistent local login(s). Without this, a random password is printed at startup.
# SEREIN_USERS={"local":"replace-with-a-long-random-password"}
SEREIN_DB_PATH=data/serein.sqlite3
SEREIN_DAILY_CALL_LIMIT=100
SEREIN_DAILY_SEARCH_LIMIT=25
SEREIN_TIMEOUT_SECONDS=20
SEREIN_MAX_OUTPUT_TOKENS=400
SEREIN_CONTEXT_MESSAGES=20
SEREIN_CONTEXT_CHARACTERS=12000
SEREIN_IDLE_SECONDS=1800
SEREIN_SESSION_SECONDS=7200
SEREIN_HISTORY_DAYS=7
SEREIN_PREFERENCE_DAYS=14
# Optional Brave Search key. Without it, DeepSeek mode uses DeepSeek Search.
# BRAVE_SEARCH_API_KEY=
# Local calendar uses a fixed UTC offset; default UTC+08:00.
SEREIN_TIMEZONE_OFFSET_MINUTES=480
SEREIN_MAX_TOOL_ROUNDS=5

# To use a different OpenAI-compatible Chat Completions provider:
# SEREIN_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# SEREIN_MODEL=
